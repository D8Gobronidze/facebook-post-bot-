GROQ_API_KEY=your_groq_api_key_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here  # can reuse FB_PAGE_ACCESS_TOKEN if it has instagram_content_publish permission
PEXELS_API_KEY=your_pexels_api_key_here  # free at pexels.com/api — for high-quality photos
HF_TOKEN=your_huggingface_token_here    # free at huggingface.co/settings/tokens — for FLUX.1 image generation
IMGBB_API_KEY=your_imgbb_api_key_here   # free at api.imgbb.com — hosts the generated image
